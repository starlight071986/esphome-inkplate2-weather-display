# Copy to your ESPHome secrets.yaml, or merge the missing keys into it.

wifi_ssid: "YourNetwork"
wifi_password: "your-wifi-password"

# Password for the fallback hotspot the device opens if WiFi fails
ap_password: "fallback-password"

# Generate one at https://esphome.io/components/api
api_encryption_key: "base64-encoded-32-byte-key"

ota_password: "your-ota-password"
